<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="app.diagrams.net" agent="SIGRO generar_drawio.py" version="24.0.0" type="device">
  <diagram id="Microservicios" name="Microservicios">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1860" pageHeight="1470" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="c2" value="&lt;b style=&quot;font-size:22px&quot;&gt;SIGRO · Esquema de microservicios (frontera API ↔ servicios)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px;color:#555555&quot;&gt;Monolito modular + 2 microservicios · ADR-01 y ADR-07 · estado al 22 de octubre de 2026&lt;/span&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="0" y="0" width="1100" height="60" as="geometry" />
        </mxCell>
        <mxCell id="g_cli" value="Clientes" style="swimlane;startSize=30;html=1;rounded=1;arcSize=2;fontStyle=1;fontSize=14;fillColor=#F2F2F2;strokeColor=#666666;strokeWidth=2;swimlaneFillColor=#F2F2F2;align=left;spacingLeft=10;collapsible=0;" vertex="1" parent="1">
          <mxGeometry x="330" y="80" width="640" height="150" as="geometry" />
        </mxCell>
        <mxCell id="android" value="&lt;b&gt;App Android&lt;/b&gt;&lt;br&gt;almacenero · SSOMA&lt;br&gt;cola local: registra sin señal&lt;div style=&quot;background:#FFF2CC;color:#7F6000;padding:3px;margin-top:4px&quot;&gt;&lt;i&gt;cada registro lleva su uuid_cliente&lt;/i&gt;&lt;/div&gt;" style="rounded=1;arcSize=4;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=8;fillColor=#FFFFFF;strokeColor=#555555;strokeWidth=1.5;fontSize=12;" vertex="1" parent="g_cli">
          <mxGeometry x="20" y="42" width="290" height="96" as="geometry" />
        </mxCell>
        <mxCell id="web" value="&lt;b&gt;Web de oficina&lt;/b&gt;&lt;br&gt;React + Vite · &lt;i&gt;web/&lt;/i&gt;&lt;br&gt;residente · administrador · gerente" style="rounded=1;arcSize=4;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=8;fillColor=#FFFFFF;strokeColor=#555555;strokeWidth=1.5;fontSize=12;" vertex="1" parent="g_cli">
          <mxGeometry x="330" y="42" width="290" height="96" as="geometry" />
        </mxCell>
        <mxCell id="g_api" value="API SIGRO · monolito modular (FastAPI) · /api/v1" style="swimlane;startSize=30;html=1;rounded=1;arcSize=2;fontStyle=1;fontSize=14;fillColor=#EAF1F8;strokeColor=#1F4E79;strokeWidth=2;swimlaneFillColor=#EAF1F8;align=left;spacingLeft=10;collapsible=0;" vertex="1" parent="1">
          <mxGeometry x="40" y="330" width="700" height="700" as="geometry" />
        </mxCell>
        <mxCell id="seg" value="&lt;b&gt;Seguridad (transversal)&lt;/b&gt;&lt;br&gt;JWT: solo dice &lt;b&gt;quién&lt;/b&gt; eres&lt;br&gt;rol y obra se leen de &lt;i&gt;asignación&lt;/i&gt; en cada petición&lt;br&gt;login Argon2id · bloqueo a los 5 intentos&lt;div style=&quot;background:#FFF2CC;color:#7F6000;padding:3px;margin-top:4px&quot;&gt;&lt;i&gt;esconder un botón no es control de acceso&lt;/i&gt;&lt;/div&gt;" style="rounded=1;arcSize=4;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=8;fillColor=#FFFFFF;strokeColor=#1F4E79;strokeWidth=1.5;fontSize=12;" vertex="1" parent="g_api">
          <mxGeometry x="40" y="50" width="620" height="130" as="geometry" />
        </mxCell>
        <mxCell id="mods" value="&lt;b&gt;Módulos (un esquema cada uno)&lt;/b&gt;&lt;br&gt;&lt;b&gt;obra&lt;/b&gt; accesos, plazos, periodos · &lt;b&gt;tareo&lt;/b&gt; trabajadores y jornadas&lt;br&gt;&lt;b&gt;compras&lt;/b&gt; proveedores, compras, solicitudes · &lt;b&gt;catálogo&lt;/b&gt; insumos (provisional)&lt;br&gt;&lt;font color=&quot;#777777&quot;&gt;&lt;b&gt;almacén&lt;/b&gt; y &lt;b&gt;costo&lt;/b&gt; · Henry · pendientes&lt;/font&gt;&lt;br&gt;Dependencias solo hacia &lt;b&gt;obra&lt;/b&gt; y &lt;b&gt;catálogo&lt;/b&gt; (una prueba lo vigila)" style="rounded=1;arcSize=4;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=8;fillColor=#D9E7F5;strokeColor=#1F4E79;strokeWidth=1.5;fontSize=12;" vertex="1" parent="g_api">
          <mxGeometry x="40" y="235" width="620" height="140" as="geometry" />
        </mxCell>
        <mxCell id="db" value="&lt;b&gt;PostgreSQL 16&lt;/b&gt;&lt;br&gt;esquemas: obra · catálogo · compras · tareo · &lt;b&gt;outbox&lt;/b&gt;&lt;br&gt;la API entra como &lt;b&gt;sigro_app&lt;/b&gt;: sin DELETE, sin UPDATE en libros&lt;br&gt;migraciones con el usuario dueño (Alembic)&lt;div style=&quot;background:#FFF2CC;color:#7F6000;padding:3px;margin-top:4px&quot;&gt;&lt;i&gt;&lt;b&gt;Ningún microservicio lee ni escribe esta base&lt;/b&gt;&lt;/i&gt;&lt;/div&gt;" style="rounded=1;arcSize=4;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=8;fillColor=#FFFFFF;strokeColor=#333333;strokeWidth=1.5;fontSize=12;" vertex="1" parent="g_api">
          <mxGeometry x="40" y="480" width="620" height="160" as="geometry" />
        </mxCell>
        <mxCell id="relevo" value="&lt;b&gt;Relevo (worker)&lt;/b&gt;&lt;br&gt;&lt;i&gt;python -m app.relay&lt;/i&gt;&lt;br&gt;toma lo pendiente de outbox.evento&lt;br&gt;FOR UPDATE SKIP LOCKED: varios relevos no repiten&lt;br&gt;reintentos: 5 s → 10 → 20 … hasta 1 h&lt;div style=&quot;background:#FFF2CC;color:#7F6000;padding:3px;margin-top:4px&quot;&gt;&lt;i&gt;al menos una vez; el receptor deduplica&lt;/i&gt;&lt;/div&gt;" style="rounded=1;arcSize=4;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=8;fillColor=#FFFFFF;strokeColor=#8A3B12;strokeWidth=1.5;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="60" y="1130" width="380" height="170" as="geometry" />
        </mxCell>
        <mxCell id="g_not" value="Microservicio · Notificaciones" style="swimlane;startSize=30;html=1;rounded=1;arcSize=2;fontStyle=1;fontSize=14;fillColor=#FBEDE6;strokeColor=#8A3B12;strokeWidth=2;swimlaneFillColor=#FBEDE6;align=left;spacingLeft=10;collapsible=0;" vertex="1" parent="1">
          <mxGeometry x="520" y="1130" width="640" height="210" as="geometry" />
        </mxCell>
        <mxCell id="notif" value="&lt;b&gt;FastAPI · SQLite propia&lt;/b&gt;&lt;br&gt;&lt;b&gt;POST&lt;/b&gt; /eventos (token de servicio)&lt;br&gt;&lt;b&gt;GET&lt;/b&gt; /notificaciones · &lt;b&gt;POST&lt;/b&gt; …/{id}/leida&lt;br&gt;deduplica por &lt;i&gt;evento_id&lt;/i&gt; · una fila por destinatario&lt;div style=&quot;background:#FFF2CC;color:#7F6000;padding:3px;margin-top:4px&quot;&gt;&lt;i&gt;los destinatarios los decide la API (solo ella sabe quién es qué en cada obra)&lt;/i&gt;&lt;/div&gt;" style="rounded=1;arcSize=4;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=8;fillColor=#FFFFFF;strokeColor=#8A3B12;strokeWidth=1.5;fontSize=12;" vertex="1" parent="g_not">
          <mxGeometry x="20" y="45" width="600" height="150" as="geometry" />
        </mxCell>
        <mxCell id="g_int" value="Microservicio · Integraciones (Fernando)" style="swimlane;startSize=30;html=1;rounded=1;arcSize=2;fontStyle=1;fontSize=14;fillColor=#FBF3E4;strokeColor=#7A4B00;strokeWidth=2;swimlaneFillColor=#FBF3E4;align=left;spacingLeft=10;collapsible=0;" vertex="1" parent="1">
          <mxGeometry x="800" y="600" width="460" height="260" as="geometry" />
        </mxCell>
        <mxCell id="integ" value="&lt;b&gt;FastAPI · sin base de datos&lt;/b&gt;&lt;br&gt;&lt;b&gt;GET&lt;/b&gt; /ruc/{ruc} · HU-31&lt;br&gt;&lt;b&gt;GET&lt;/b&gt; /dni/{dni} · HU-62&lt;br&gt;&lt;b&gt;POST&lt;/b&gt; /s10/relacion-insumos · HU-07&lt;br&gt;caché de 24 h · el token de Factiliza solo vive aquí&lt;div style=&quot;background:#FDE0E0;color:#9C0006;padding:3px;margin-top:4px&quot;&gt;&lt;i&gt;&lt;b&gt;Riesgo: no autentica a quien le llama.&lt;/b&gt; Quien lo alcance gasta las 100 consultas del mes.&lt;/i&gt;&lt;/div&gt;" style="rounded=1;arcSize=4;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=8;fillColor=#FFFFFF;strokeColor=#7A4B00;strokeWidth=1.5;fontSize=12;" vertex="1" parent="g_int">
          <mxGeometry x="20" y="45" width="420" height="200" as="geometry" />
        </mxCell>
        <mxCell id="fact" value="&lt;b&gt;Factiliza&lt;/b&gt;&lt;br&gt;SUNAT (RUC) · RENIEC (DNI)&lt;br&gt;100 consultas gratis al mes" style="rounded=1;arcSize=4;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=8;fillColor=#FFFFFF;strokeColor=#999999;strokeWidth=1.5;fontSize=12;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="880" y="960" width="300" height="80" as="geometry" />
        </mxCell>
        <mxCell id="s10" value="&lt;b&gt;Relación de insumos del S10&lt;/b&gt;&lt;br&gt;PDF que sube el usuario" style="rounded=1;arcSize=4;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=8;fillColor=#FFFFFF;strokeColor=#999999;strokeWidth=1.5;fontSize=12;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="880" y="450" width="300" height="60" as="geometry" />
        </mxCell>
        <mxCell id="ley" value="&lt;b&gt;Qué pasa si una pieza cae&lt;/b&gt;&lt;br&gt;&lt;b&gt;Integraciones cae&lt;/b&gt; → el proveedor queda «sin validar» y el trabajador se escribe a mano. El archivo S10 no se pierde. Nada se bloquea.&lt;br&gt;&lt;b&gt;Notificaciones cae&lt;/b&gt; → la API sigue; los avisos esperan en &lt;i&gt;outbox&lt;/i&gt; y llegan después. La campana responde 503 un rato.&lt;br&gt;&lt;b&gt;El relevo cae&lt;/b&gt; → los eventos se acumulan en la base; no se pierde ninguno.&lt;br&gt;&lt;b&gt;Celular sin señal&lt;/b&gt; → la app registra en su cola; al volver, el &lt;i&gt;uuid_cliente&lt;/i&gt; impide que un reenvío duplique.&lt;br&gt;&lt;b&gt;Por qué no seis microservicios:&lt;/b&gt; una compra y su detalle, un movimiento y su saldo deben ser atómicos; entre servicios sería una saga con compensaciones.&lt;div style=&quot;background:#FDE0E0;color:#9C0006;padding:3px;margin-top:4px&quot;&gt;&lt;i&gt;&lt;b&gt;Flecha 3 · por decidir (Fernando y el equipo):&lt;/b&gt; que la web llame a Integraciones a través de la API, o que Integraciones exija un token de servicio. Hoy ninguna de las dos está resuelta.&lt;/i&gt;&lt;/div&gt;" style="rounded=1;arcSize=4;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=8;fillColor=#FFFFFF;strokeColor=#666666;strokeWidth=1.5;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1220" y="1100" width="520" height="250" as="geometry" />
        </mxCell>
        <mxCell id="c3" value="1 · HTTPS · JSON · Bearer JWT" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#444444;fontColor=#444444;fontSize=11;strokeWidth=1.6;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;" edge="1" source="web" target="seg" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c4" value="1 · HTTPS · JSON · Bearer JWT" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#444444;fontColor=#444444;fontSize=11;strokeWidth=1.6;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;" edge="1" source="android" target="seg" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#444444;fontColor=#444444;fontSize=11;strokeWidth=1.6;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;" edge="1" source="seg" target="mods" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c6" value="misma transacción: hecho + evento" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#444444;fontColor=#444444;fontSize=11;strokeWidth=1.6;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;" edge="1" source="mods" target="db" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c7" value="2 · HTTP · validar RUC al crear proveedor" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#7A4B00;fontColor=#7A4B00;fontSize=11;strokeWidth=1.6;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;" edge="1" source="mods" target="integ" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c8" value="3 · hoy: directo (RUC y S10)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#9C0006;fontColor=#9C0006;fontSize=11;strokeWidth=1.6;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;dashed=1;" edge="1" source="web" target="integ" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c9" value="sube el PDF" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#999999;fontColor=#999999;fontSize=11;strokeWidth=1.6;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;dashed=1;" edge="1" source="s10" target="integ" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c10" value="Bearer" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#7A4B00;fontColor=#7A4B00;fontSize=11;strokeWidth=1.6;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;" edge="1" source="integ" target="fact" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c11" value="4 · lee pendientes y anota el resultado" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#8A3B12;fontColor=#8A3B12;fontSize=11;strokeWidth=1.6;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;startArrow=block;startFill=1;" edge="1" source="db" target="relevo" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c12" value="5 · POST /eventos · X-Servicio-Token" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#8A3B12;fontColor=#8A3B12;fontSize=11;strokeWidth=1.6;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;" edge="1" source="relevo" target="notif" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c13" value="6 · campana: GET /notificaciones" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#8A3B12;fontColor=#8A3B12;fontSize=11;strokeWidth=1.6;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;dashed=1;exitX=1;exitY=0.8;entryX=0.4;entryY=0;" edge="1" source="mods" target="notif" parent="1">
          <mxGeometry relative="1" as="geometry">
