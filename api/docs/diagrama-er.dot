digraph ER {
  graph [rankdir=TB, fontname="Helvetica", fontsize=26, labelloc=t, pad=0.4, nodesep=0.55, ranksep=1.0, splines=true, newrank=true, label=<<B>SIGRO · Diagrama entidad-relación (modelo lógico)</B><BR/><FONT POINT-SIZE="15">Qué cosas existen en la obra y cómo se relacionan · verificado contra la base migrada (0001 a 0006)</FONT>>];
  node [shape=plain, fontname="Helvetica", fontsize=11];
  edge [color="#444444", fontname="Helvetica", fontsize=10, arrowsize=1.1, dir=both];
  subgraph cluster_obra { label=<<B>Obra y accesos</B>>; fontsize=17; style="rounded,filled"; fillcolor="#EAF1F8"; color="#1F4E79"; penwidth=2;
    "obra.usuario" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#1F4E79"><TR><TD BGCOLOR="#1F4E79"><FONT COLOR="white" POINT-SIZE="13"><B>Usuario</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><U><B>Usuario (nombre de acceso)</B></U></TD></TR><TR><TD ALIGN="LEFT"><FONT>Nombre</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT>Clave (solo su hash)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT>Estado: activo / baja</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#777777">Fecha de baja (opcional)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#777777">Bloqueado hasta (opcional)</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#FFF2CC"><FONT POINT-SIZE="9" COLOR="#7F6000"><I>No tiene rol: el rol vive en la Asignación</I></FONT></TD></TR></TABLE>>];
    "obra.proyecto" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#1F4E79"><TR><TD BGCOLOR="#1F4E79"><FONT COLOR="white" POINT-SIZE="13"><B>Obra</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><U><B>Nombre</B></U></TD></TR><TR><TD ALIGN="LEFT"><FONT>Fecha de inicio</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT>Fecha de fin</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT>Día de corte semanal</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT>Estado: en ejecución / cerrado</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#FFF2CC"><FONT POINT-SIZE="9" COLOR="#7F6000"><I>Todo lo demás cuelga de una obra</I></FONT></TD></TR></TABLE>>];
    "obra.periodo" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#1F4E79"><TR><TD BGCOLOR="#1F4E79"><FONT COLOR="white" POINT-SIZE="13"><B>Periodo (semana)</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><U><B>Número</B></U></TD></TR><TR><TD ALIGN="LEFT"><FONT>Desde</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT>Hasta</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT>Estado: abierto / cerrado</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#777777">Cerrado en (opcional)</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#FFF2CC"><FONT POINT-SIZE="9" COLOR="#7F6000"><I>Lo genera el sistema al crear la obra</I></FONT></TD></TR></TABLE>>];
    "obra.almacen" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#1F4E79"><TR><TD BGCOLOR="#1F4E79"><FONT COLOR="white" POINT-SIZE="13"><B>Almacén</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><U><B>Nombre</B></U></TD></TR><TR><TD ALIGN="LEFT"><FONT>Tipo: central / frente</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT>Estado: activo / inactivo</FONT></TD></TR></TABLE>>];
    "obra.asignacion" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#1F4E79"><TR><TD BGCOLOR="#1F4E79"><FONT COLOR="white" POINT-SIZE="13"><B>Asignación</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT>Rol: almacenero / SSOMA / residente / administrador / gerente</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT>Desde</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#777777">Hasta (opcional)</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#FFF2CC"><FONT POINT-SIZE="9" COLOR="#7F6000"><I>Una vigente por persona y obra · aquí vive el rol</I></FONT></TD></TR></TABLE>>];
    "obra.dispositivo" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#1F4E79"><TR><TD BGCOLOR="#1F4E79"><FONT COLOR="white" POINT-SIZE="13"><B>Dispositivo (celular)</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT>Identificador</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT>Estado: pendiente / activo / revocado</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT>Solicitado en</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#777777">Autorizado en (opcional)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#777777">Revocado en (opcional)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#777777">Motivo de revocación (opcional)</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#FFF2CC"><FONT POINT-SIZE="9" COLOR="#7F6000"><I>1 activo por responsable · máx. 2 por obra</I></FONT></TD></TR></TABLE>>];
    "obra.proyecto_plazo_historial" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#1F4E79"><TR><TD BGCOLOR="#1F4E79"><FONT COLOR="white" POINT-SIZE="13"><B>Ampliación de plazo</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT>Fecha de fin anterior</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT>Fecha de fin nueva</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT>Motivo</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT>Fecha</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#FFF2CC"><FONT POINT-SIZE="9" COLOR="#7F6000"><I>Libro: solo se agrega</I></FONT></TD></TR></TABLE>>];
  }
  subgraph cluster_catalogo { label=<<B>Catálogo</B>>; fontsize=17; style="rounded,filled"; fillcolor="#FBF3E4"; color="#7A4B00"; penwidth=2;
    "catalogo.insumo" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#7A4B00"><TR><TD BGCOLOR="#7A4B00"><FONT COLOR="white" POINT-SIZE="13"><B>Insumo</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><U><B>Código</B></U></TD></TR><TR><TD ALIGN="LEFT"><FONT>Descripción</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT>Unidad del S10</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT>Unidad de compra</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT>Factor de conversión</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT>Tipo: material / mano de obra / equipo / subcontrato</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT>Verificado</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT>Activo</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#FFF2CC"><FONT POINT-SIZE="9" COLOR="#7F6000"><I>El código no cambia · es de la empresa, no de la obra</I></FONT></TD></TR></TABLE>>];
    "catalogo.insumo_nombre_comercial" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#7A4B00"><TR><TD BGCOLOR="#7A4B00"><FONT COLOR="white" POINT-SIZE="13"><B>Nombre comercial</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><U><B>Nombre</B></U></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#FFF2CC"><FONT POINT-SIZE="9" COLOR="#7F6000"><I>Cómo lo llaman los proveedores</I></FONT></TD></TR></TABLE>>];
  }
  subgraph cluster_compras { label=<<B>Compras</B>>; fontsize=17; style="rounded,filled"; fillcolor="#EAF5EC"; color="#2E6B3A"; penwidth=2;
    "compras.proveedor" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#2E6B3A"><TR><TD BGCOLOR="#2E6B3A"><FONT COLOR="white" POINT-SIZE="13"><B>Proveedor</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><U><B>RUC</B></U></TD></TR><TR><TD ALIGN="LEFT"><FONT>Razón social</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT>Validación: validado / sin validar</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#777777">Validado en (opcional)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT>Estado: activo / baja</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#777777">Fecha de baja (opcional)</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#FFF2CC"><FONT POINT-SIZE="9" COLOR="#7F6000"><I>Es de la empresa, no de la obra</I></FONT></TD></TR></TABLE>>];
    "compras.compra" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#2E6B3A"><TR><TD BGCOLOR="#2E6B3A"><FONT COLOR="white" POINT-SIZE="13"><B>Compra</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><U><B>Tipo de comprobante</B></U></TD></TR><TR><TD ALIGN="LEFT"><U><B>N.º de comprobante</B></U></TD></TR><TR><TD ALIGN="LEFT"><FONT>Fecha</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT>Moneda: PEN / USD</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT>Base imponible</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT>IGV</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT>Total</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT>Estado: registrada / anulada</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#777777">Motivo de anulación (opcional)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#777777">Anulada en (opcional)</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#FFF2CC"><FONT POINT-SIZE="9" COLOR="#7F6000"><I>No se edita: se anula con motivo · comprobante único por proveedor</I></FONT></TD></TR></TABLE>>];
    "compras.compra_detalle" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#2E6B3A"><TR><TD BGCOLOR="#2E6B3A"><FONT COLOR="white" POINT-SIZE="13"><B>Línea de compra</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT>Cantidad</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT>Unidad</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT>Precio unitario</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#FFF2CC"><FONT POINT-SIZE="9" COLOR="#7F6000"><I>Libro: solo se agrega · un insumo una vez por compra</I></FONT></TD></TR></TABLE>>];
    "compras.compra_adjunto" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#2E6B3A"><TR><TD BGCOLOR="#2E6B3A"><FONT COLOR="white" POINT-SIZE="13"><B>Adjunto de compra</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT>Archivo</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT>Nombre original</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT>Tipo</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT>Tamaño</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT>Huella SHA-256</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#FFF2CC"><FONT POINT-SIZE="9" COLOR="#7F6000"><I>Libro · el mismo archivo no se sube dos veces</I></FONT></TD></TR></TABLE>>];
    "compras.solicitud" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#2E6B3A"><TR><TD BGCOLOR="#2E6B3A"><FONT COLOR="white" POINT-SIZE="13"><B>Solicitud de materiales</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><U><B>N.º (correlativo por obra)</B></U></TD></TR><TR><TD ALIGN="LEFT"><FONT>Fecha</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT>Estado: emitida / anulada</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#777777">Motivo de anulación (opcional)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#777777">Anulada en (opcional)</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#FFF2CC"><FONT POINT-SIZE="9" COLOR="#7F6000"><I>Emitida por el residente · nunca es pedido automático</I></FONT></TD></TR></TABLE>>];
    "compras.solicitud_linea" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#2E6B3A"><TR><TD BGCOLOR="#2E6B3A"><FONT COLOR="white" POINT-SIZE="13"><B>Línea de solicitud</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#777777">Descripción libre (opcional)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT>Cantidad</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT>Unidad de compra</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#FFF2CC"><FONT POINT-SIZE="9" COLOR="#7F6000"><I>Libro · el insumo puede faltar (línea libre)</I></FONT></TD></TR></TABLE>>];
  }
  subgraph cluster_tareo { label=<<B>Mano de obra</B>>; fontsize=17; style="rounded,filled"; fillcolor="#F6ECF6"; color="#6B2E6B"; penwidth=2;
    "tareo.trabajador" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#6B2E6B"><TR><TD BGCOLOR="#6B2E6B"><FONT COLOR="white" POINT-SIZE="13"><B>Trabajador</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><U><B>Documento</B></U></TD></TR><TR><TD ALIGN="LEFT"><FONT>Tipo de documento: DNI / CE / pasaporte</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT>Nombre</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT>Categoría: operario / oficial / peón</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT>Cuadrilla</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT>Fecha de ingreso</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#777777">Fecha de salida (opcional)</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#FFF2CC"><FONT POINT-SIZE="9" COLOR="#7F6000"><I>Por obra · se da de baja, no se borra</I></FONT></TD></TR></TABLE>>];
    "tareo.jornada" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#6B2E6B"><TR><TD BGCOLOR="#6B2E6B"><FONT COLOR="white" POINT-SIZE="13"><B>Jornada</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT>Fecha</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT>Horas normales</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT>Horas extra</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT>Categoría (congelada al registrar)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT>Asistencia: presente / ausente / permiso</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#777777">Identificador del celular (opcional)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#777777">Motivo de corrección (opcional)</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#FFF2CC"><FONT POINT-SIZE="9" COLOR="#7F6000"><I>Libro: se corrige agregando otra · una vigente por trabajador y día</I></FONT></TD></TR></TABLE>>];
  }
  subgraph cluster_outbox { label=<<B>Avisos (infraestructura)</B>>; fontsize=17; style="rounded,filled"; fillcolor="#FBEDE6"; color="#8A3B12"; penwidth=2;
    "outbox.evento" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#8A3B12"><TR><TD BGCOLOR="#8A3B12"><FONT COLOR="white" POINT-SIZE="13"><B>Evento por avisar</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT>Tipo</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT>Contenido</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT>Creado en</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#777777">Entregado en (opcional)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT>Intentos</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#777777">Último error (opcional)</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#FFF2CC"><FONT POINT-SIZE="9" COLOR="#7F6000"><I>Se escribe en la misma transacción que el hecho</I></FONT></TD></TR></TABLE>>];
  }
  subgraph cluster_henry { label=<<B>Almacén y costo (Henry) · aún sin migración</B>>; fontsize=17; style="rounded,dashed"; color="#999999";
    "almacen.movimiento" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#999999" STYLE="dashed"><TR><TD BGCOLOR="#7F7F7F"><FONT COLOR="white" POINT-SIZE="13"><B>Movimiento</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><U><B>Identificador del celular (único)</B></U></TD></TR><TR><TD ALIGN="LEFT">Tipo · cantidad · costo unitario</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#FFF2CC"><FONT POINT-SIZE="9" COLOR="#7F6000"><I>Libro: solo se agrega · sin saldo guardado:<BR/>el saldo se suma desde los movimientos</I></FONT></TD></TR></TABLE>>];
  }
  "obra.usuario" -> "obra.asignacion" [label=" tiene ", arrowtail=teetee, arrowhead=crowodot];
  "obra.proyecto" -> "obra.asignacion" [label=" se asigna a ", arrowtail=teetee, arrowhead=crowodot];
  "obra.usuario" -> "obra.dispositivo" [label=" usa ", arrowtail=teetee, arrowhead=crowodot];
  "obra.proyecto" -> "obra.dispositivo" [label=" se autoriza en ", arrowtail=teetee, arrowhead=crowodot];
  "obra.proyecto" -> "obra.periodo" [label=" se divide en ", arrowtail=teetee, arrowhead=crowodot];
  "obra.proyecto" -> "obra.almacen" [label=" tiene ", arrowtail=teetee, arrowhead=crowodot];
  "obra.proyecto" -> "obra.proyecto_plazo_historial" [label=" se amplía con ", arrowtail=teetee, arrowhead=crowodot];
  "catalogo.insumo" -> "catalogo.insumo_nombre_comercial" [label=" se conoce como ", arrowtail=teetee, arrowhead=crowodot];
  "obra.proyecto" -> "compras.compra" [label=" se registra en ", arrowtail=teetee, arrowhead=crowodot];
  "compras.proveedor" -> "compras.compra" [label=" se compra a ", arrowtail=teetee, arrowhead=crowodot];
  "compras.solicitud" -> "compras.compra" [label=" se atiende con ", arrowtail=teeodot, arrowhead=crowodot];
  "compras.compra" -> "compras.compra_detalle" [label=" se compone de ", arrowtail=teetee, arrowhead=crowodot];
  "catalogo.insumo" -> "compras.compra_detalle" [label=" es de ", arrowtail=teetee, arrowhead=crowodot];
  "compras.compra" -> "compras.compra_adjunto" [label=" se respalda con ", arrowtail=teetee, arrowhead=crowodot];
  "obra.proyecto" -> "compras.solicitud" [label=" se emite en ", arrowtail=teetee, arrowhead=crowodot];
  "compras.solicitud" -> "compras.solicitud_linea" [label=" se compone de ", arrowtail=teetee, arrowhead=crowodot];
  "catalogo.insumo" -> "compras.solicitud_linea" [label=" pide ", arrowtail=teeodot, arrowhead=crowodot];
  "obra.proyecto" -> "tareo.trabajador" [label=" trabaja en ", arrowtail=teetee, arrowhead=crowodot];
  "tareo.trabajador" -> "tareo.jornada" [label=" registra ", arrowtail=teetee, arrowhead=crowodot];
  "obra.periodo" -> "tareo.jornada" [label=" cae en ", arrowtail=teetee, arrowhead=crowodot];
  "tareo.jornada" -> "tareo.jornada" [taillabel="0..N", headlabel="0..1", label="corrige a", arrowtail=crowodot, arrowhead=teeodot, headport=e, tailport=e];
  "obra.proyecto" -> "outbox.evento" [label=" avisa sobre ", arrowtail=teetee, arrowhead=crowodot];
  "obra.almacen" -> "almacen.movimiento" [label=" se guarda en ", arrowtail=teetee, arrowhead=crowodot, style=dashed, color="#999999", fontcolor="#777777"];
  "obra.periodo" -> "almacen.movimiento" [label=" cae en ", arrowtail=teetee, arrowhead=crowodot, style=dashed, color="#999999", fontcolor="#777777"];
  "obra.dispositivo" -> "almacen.movimiento" [label=" se registra desde ", arrowtail=teetee, arrowhead=crowodot, style=dashed, color="#999999", fontcolor="#777777"];
  "catalogo.insumo" -> "almacen.movimiento" [label=" mueve a ", arrowtail=teetee, arrowhead=crowodot, style=dashed, color="#999999", fontcolor="#777777"];
  "compras.compra" -> "almacen.movimiento" [label=" se recibe en (solo ingreso) ", arrowtail=teetee, arrowhead=crowodot, style=dashed, color="#999999", fontcolor="#777777"];
  subgraph cluster_leyenda { label=<<B>Cómo leerlo</B>>; fontsize=16; style="rounded"; color="#666666";
    leyenda [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3"><TR><TD ALIGN="LEFT"><U><B>Subrayado</B></U>  lo que identifica a la entidad (en una obra, nunca se repite)</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#777777">gris (opcional)</FONT>  puede quedar vacío</TD></TR><TR><TD ALIGN="LEFT"><B>||──</B> uno y solo uno · <B>|o──</B> uno o ninguno · <B>──o&lt;</B> ninguno, uno o varios</TD></TR><TR><TD ALIGN="LEFT">Leer así: «<I>Obra</I> se divide en (0..N) <I>Periodos</I>»; cada Periodo es de exactamente una Obra.</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#FFF2CC"><FONT COLOR="#7F6000"><I>Regla en amarillo</I>  lo que el motor de la base impide romper</FONT></TD></TR><TR><TD ALIGN="LEFT"><B>Asignación</B> es la relación Usuario–Obra con atributo propio (el rol): una persona puede ser almacenero en una obra y nada en otra.</TD></TR><TR><TD ALIGN="LEFT">Quién registró, anuló, autorizó o cerró cada hecho (siempre un <B>Usuario</B>) no se dibuja para no saturar; está en el físico.</TD></TR><TR><TD ALIGN="LEFT">El contador del correlativo de solicitudes es una tabla técnica y no se dibuja.</TD></TR><TR><TD ALIGN="LEFT">Línea punteada: contrato con el módulo de Henry (aún sin migración).</TD></TR></TABLE>>];
  }
}