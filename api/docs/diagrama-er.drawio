        <mxCell id="c168" value="se recibe en (solo ingreso)" style="rounded=0;html=1;strokeColor=#999999;strokeWidth=1.3;fontSize=10;fontColor=#999999;labelBackgroundColor=#FFFFFF;startArrow=ERmandOne;endArrow=ERzeroToMany;startFill=0;endFill=0;startSize=12;endSize=12;dashed=1;" edge="1" source="c75" target="c137" parent="1">
