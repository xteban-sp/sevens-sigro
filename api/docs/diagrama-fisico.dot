B>  </B></FONT></TD><TD ALIGN="LEFT">categoria</TD><TD ALIGN="LEFT"><FONT COLOR="#666666" POINT-SIZE="10">text</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="c_periodo_id"><FONT POINT-SIZE="10" COLOR="#E46C0A"><B>FK*</B></FONT></TD><TD ALIGN="LEFT">periodo_id</TD><TD ALIGN="LEFT"><FONT COLOR="#666666" POINT-SIZE="10">bigint</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="c_registrado_por"><FONT POINT-SIZE="10" COLOR="#E46C0A"><B>FK*</B></FONT></TD><TD ALIGN="LEFT">registrado_por</TD><TD ALIGN="LEFT"><FONT COLOR="#666666" POINT-SIZE="10">bigint</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="c_fecha_servidor"><FONT POINT-SIZE="10" COLOR="#B00020"><B>  </B></FONT></TD><TD ALIGN="LEFT">fecha_servidor</TD><TD ALIGN="LEFT"><FONT COLOR="#666666" POINT-SIZE="10">timestamptz</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="c_corrige_a_id"><FONT POINT-SIZE="10" COLOR="#B00020"><B>FK</B></FONT></TD><TD ALIGN="LEFT">corrige_a_id</TD><TD ALIGN="LEFT"><FONT COLOR="#666666" POINT-SIZE="10">bigint?</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="c_motivo_correccion"><FONT POINT-SIZE="10" COLOR="#B00020"><B>  </B></FONT></TD><TD ALIGN="LEFT">motivo_correccion</TD><TD ALIGN="LEFT"><FONT COLOR="#666666" POINT-SIZE="10">text?</FONT></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT" BGCOLOR="#FFF2CC"><FONT POINT-SIZE="10" COLOR="#7F6000"><B>UNIQUE (corrige_a_id)<BR/>  WHERE corrige_a_id IS NOT NULL</B></FONT></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT" BGCOLOR="#FFF2CC"><FONT POINT-SIZE="10" COLOR="#7F6000"><B>UNIQUE (id, trabajador_id, fecha)</B></FONT></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT" BGCOLOR="#FFF2CC"><FONT POINT-SIZE="10" COLOR="#7F6000"><B>UNIQUE (trabajador_id, fecha)<BR/>  WHERE corrige_a_id IS NULL</B></FONT></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT" BGCOLOR="#FFF2CC"><FONT POINT-SIZE="10" COLOR="#7F6000"><B>UNIQUE (uuid_cliente)<BR/>  WHERE uuid_cliente IS NOT NULL</B></FONT></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT" BGCOLOR="#F2F2F2"><FONT POINT-SIZE="9" COLOR="#444444">sin UPDATE · sin DELETE</FONT></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT" BGCOLOR="#F2F2F2"><FONT POINT-SIZE="9" COLOR="#444444">reglas: jornada_validar</FONT></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT" BGCOLOR="#F2F2F2"><FONT POINT-SIZE="9" COLOR="#444444">5 CHECK · 2 índices</FONT></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT" BGCOLOR="#F2F2F2"><FONT POINT-SIZE="9" COLOR="#444444">permisos: tareo S I</FONT></TD></TR></TABLE>>];
    "tareo.trabajador" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#6B2E6B"><TR><TD COLSPAN="3" BGCOLOR="#6B2E6B"><FONT COLOR="white"><B>tareo.trabajador</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="c_id"><FONT POINT-SIZE="10" COLOR="#B00020"><B>PK</B></FONT></TD><TD ALIGN="LEFT">id</TD><TD ALIGN="LEFT"><FONT COLOR="#666666" POINT-SIZE="10">bigint</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="c_proyecto_id"><FONT POINT-SIZE="10" COLOR="#E46C0A"><B>FK*</B></FONT></TD><TD ALIGN="LEFT">proyecto_id</TD><TD ALIGN="LEFT"><FONT COLOR="#666666" POINT-SIZE="10">bigint</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="c_nombre"><FONT POINT-SIZE="10" COLOR="#B00020"><B>  </B></FONT></TD><TD ALIGN="LEFT">nombre</TD><TD ALIGN="LEFT"><FONT COLOR="#666666" POINT-SIZE="10">text</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="c_tipo_documento"><FONT POINT-SIZE="10" COLOR="#B00020"><B>  </B></FONT></TD><TD ALIGN="LEFT">tipo_documento</TD><TD ALIGN="LEFT"><FONT COLOR="#666666" POINT-SIZE="10">text</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="c_documento"><FONT POINT-SIZE="10" COLOR="#B00020"><B>  </B></FONT></TD><TD ALIGN="LEFT">documento</TD><TD ALIGN="LEFT"><FONT COLOR="#666666" POINT-SIZE="10">text</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="c_categoria"><FONT POINT-SIZE="10" COLOR="#B00020"><B>  </B></FONT></TD><TD ALIGN="LEFT">categoria</TD><TD ALIGN="LEFT"><FONT COLOR="#666666" POINT-SIZE="10">text</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="c_cuadrilla"><FONT POINT-SIZE="10" COLOR="#B00020"><B>  </B></FONT></TD><TD ALIGN="LEFT">cuadrilla</TD><TD ALIGN="LEFT"><FONT COLOR="#666666" POINT-SIZE="10">text</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="c_fecha_ingreso"><FONT POINT-SIZE="10" COLOR="#B00020"><B>  </B></FONT></TD><TD ALIGN="LEFT">fecha_ingreso</TD><TD ALIGN="LEFT"><FONT COLOR="#666666" POINT-SIZE="10">date</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="c_fecha_salida"><FONT POINT-SIZE="10" COLOR="#B00020"><B>  </B></FONT></TD><TD ALIGN="LEFT">fecha_salida</TD><TD ALIGN="LEFT"><FONT COLOR="#666666" POINT-SIZE="10">date?</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="c_registrado_por"><FONT POINT-SIZE="10" COLOR="#E46C0A"><B>FK*</B></FONT></TD><TD ALIGN="LEFT">registrado_por</TD><TD ALIGN="LEFT"><FONT COLOR="#666666" POINT-SIZE="10">bigint</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="c_creado_en"><FONT POINT-SIZE="10" COLOR="#B00020"><B>  </B></FONT></TD><TD ALIGN="LEFT">creado_en</TD><TD ALIGN="LEFT"><FONT COLOR="#666666" POINT-SIZE="10">timestamptz</FONT></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT" BGCOLOR="#FFF2CC"><FONT POINT-SIZE="10" COLOR="#7F6000"><B>UNIQUE (id, proyecto_id)</B></FONT></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT" BGCOLOR="#FFF2CC"><FONT POINT-SIZE="10" COLOR="#7F6000"><B>UNIQUE (proyecto_id, documento)</B></FONT></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT" BGCOLOR="#F2F2F2"><FONT POINT-SIZE="9" COLOR="#444444">sin DELETE (se da de baja)</FONT></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT" BGCOLOR="#F2F2F2"><FONT POINT-SIZE="9" COLOR="#444444">reglas: trabajador_validar</FONT></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT" BGCOLOR="#F2F2F2"><FONT POINT-SIZE="9" COLOR="#444444">6 CHECK · 1 índices</FONT></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT" BGCOLOR="#F2F2F2"><FONT POINT-SIZE="9" COLOR="#444444">permisos: tareo S I U</FONT></TD></TR></TABLE>>];
  }
  subgraph cluster_outbox { label=<<B>microservicio relevo</B>  ·  esquema <B>outbox</B>  ·  rol <B>sigro_svc_relevo</B><BR/><FONT POINT-SIZE="12">bandeja de salida (outbox): entrega los eventos a Notificaciones</FONT>>; fontsize=18; style="rounded,filled"; fillcolor="#FBEDE6"; color="#8A3B12"; penwidth=2;
    "outbox.evento" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#8A3B12"><TR><TD COLSPAN="3" BGCOLOR="#8A3B12"><FONT COLOR="white"><B>outbox.evento</B></FONT><FONT COLOR="#FFD966"> bandeja de salida</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="c_id"><FONT POINT-SIZE="10" COLOR="#B00020"><B>PK</B></FONT></TD><TD ALIGN="LEFT">id</TD><TD ALIGN="LEFT"><FONT COLOR="#666666" POINT-SIZE="10">bigint</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="c_tipo"><FONT POINT-SIZE="10" COLOR="#B00020"><B>  </B></FONT></TD><TD ALIGN="LEFT">tipo</TD><TD ALIGN="LEFT"><FONT COLOR="#666666" POINT-SIZE="10">text</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="c_proyecto_id"><FONT POINT-SIZE="10" COLOR="#E46C0A"><B>FK*</B></FONT></TD><TD ALIGN="LEFT">proyecto_id</TD><TD ALIGN="LEFT"><FONT COLOR="#666666" POINT-SIZE="10">bigint</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="c_payload"><FONT POINT-SIZE="10" COLOR="#B00020"><B>  </B></FONT></TD><TD ALIGN="LEFT">payload</TD><TD ALIGN="LEFT"><FONT COLOR="#666666" POINT-SIZE="10">jsonb</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="c_creado_en"><FONT POINT-SIZE="10" COLOR="#B00020"><B>  </B></FONT></TD><TD ALIGN="LEFT">creado_en</TD><TD ALIGN="LEFT"><FONT COLOR="#666666" POINT-SIZE="10">timestamptz</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="c_enviado_en"><FONT POINT-SIZE="10" COLOR="#B00020"><B>  </B></FONT></TD><TD ALIGN="LEFT">enviado_en</TD><TD ALIGN="LEFT"><FONT COLOR="#666666" POINT-SIZE="10">timestamptz?</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="c_intentos"><FONT POINT-SIZE="10" COLOR="#B00020"><B>  </B></FONT></TD><TD ALIGN="LEFT">intentos</TD><TD ALIGN="LEFT"><FONT COLOR="#666666" POINT-SIZE="10">smallint</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="c_siguiente_intento"><FONT POINT-SIZE="10" COLOR="#B00020"><B>  </B></FONT></TD><TD ALIGN="LEFT">siguiente_intento</TD><TD ALIGN="LEFT"><FONT COLOR="#666666" POINT-SIZE="10">timestamptz</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="c_ultimo_error"><FONT POINT-SIZE="10" COLOR="#B00020"><B>  </B></FONT></TD><TD ALIGN="LEFT">ultimo_error</TD><TD ALIGN="LEFT"><FONT COLOR="#666666" POINT-SIZE="10">text?</FONT></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT" BGCOLOR="#F2F2F2"><FONT POINT-SIZE="9" COLOR="#444444">sin DELETE (se da de baja)</FONT></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT" BGCOLOR="#F2F2F2"><FONT POINT-SIZE="9" COLOR="#444444">reglas: evento_cambios</FONT></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT" BGCOLOR="#F2F2F2"><FONT POINT-SIZE="9" COLOR="#444444">5 CHECK · 2 índices</FONT></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT" BGCOLOR="#F2F2F2"><FONT POINT-SIZE="9" COLOR="#444444">permisos: obras S I · compras S I · relevo S I U</FONT></TD></TR></TABLE>>];
  }
  subgraph cluster_almacen { label=<<B>microservicio almacen · esquema almacen · rol sigro_svc_almacen</B><BR/><FONT POINT-SIZE="12">por construir: movimientos, saldo y kárdex (ver propuesta 0010)</FONT>>; fontsize=18; style="rounded,dashed"; color="#999999";
    "almacen.movimiento" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#999999" STYLE="dashed"><TR><TD COLSPAN="2" BGCOLOR="#7F7F7F"><FONT COLOR="white"><B>almacen.movimiento</B></FONT><FONT COLOR="#FFD966"> APPEND-ONLY</FONT></TD></TR><TR><TD ALIGN="LEFT">uuid_cliente</TD><TD ALIGN="LEFT"><FONT COLOR="#B00020"><B>UNIQUE</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="c_almacen_id">almacen_id, proyecto_id</TD><TD><FONT COLOR="#C00000">FK</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="c_insumo_id">insumo_id</TD><TD><FONT COLOR="#C00000">FK</FONT></TD></TR><TR><TD ALIGN="LEFT">tipo · cantidad &gt; 0 · costo_unitario congelado</TD><TD></TD></TR><TR><TD COLSPAN="2" ALIGN="LEFT" BGCOLOR="#FFF2CC"><FONT POINT-SIZE="10" COLOR="#7F6000"><B>Sin columna de saldo · corregir = reverso</B></FONT></TD></TR></TABLE>>];
  }
  "almacen.movimiento":c_almacen_id -> "obra.almacen":c_id [style=dashed, color="#999999"];
  "almacen.movimiento":c_insumo_id -> "catalogo.insumo":c_id [style=dashed, color="#999999"];
  "catalogo.insumo_factor_historial":c_insumo_id -> "catalogo.insumo":c_id ;
  "catalogo.insumo_nombre_comercial":c_insumo_id -> "catalogo.insumo":c_id ;
  "compras.compra":c_proveedor_id -> "compras.proveedor":c_id ;
  "compras.compra":c_proyecto_id -> "obra.proyecto":c_id [color="#C00000", style=dashed, penwidth=1.3];
  "compras.compra":c_solicitud_id -> "compras.solicitud":c_id [color="#2F5597", penwidth=1.4];
  "compras.compra_adjunto":c_compra_id -> "compras.compra":c_id ;
  "compras.compra_detalle":c_compra_id -> "compras.compra":c_id ;
  "compras.compra_detalle":c_insumo_id -> "catalogo.insumo":c_id [color="#C00000", style=dashed, penwidth=1.3];
  "compras.parametro_reposicion":c_insumo_id -> "catalogo.insumo":c_id [color="#C00000", style=dashed, penwidth=1.3];
  "compras.parametro_reposicion":c_proyecto_id -> "obra.proyecto":c_id [color="#C00000", style=dashed, penwidth=1.3];
  "compras.requerimiento":c_insumo_id -> "catalogo.insumo":c_id [color="#C00000", style=dashed, penwidth=1.3];
  "compras.requerimiento":c_proyecto_id -> "obra.proyecto":c_id [color="#C00000", style=dashed, penwidth=1.3];
  "compras.requerimiento_ajuste":c_requerimiento_id -> "compras.requerimiento":c_id ;
  "compras.solicitud":c_proyecto_id -> "obra.proyecto":c_id [color="#C00000", style=dashed, penwidth=1.3];
  "compras.solicitud_correlativo":c_proyecto_id -> "obra.proyecto":c_id [color="#C00000", style=dashed, penwidth=1.3];
  "compras.solicitud_linea":c_insumo_id -> "catalogo.insumo":c_id [color="#C00000", style=dashed, penwidth=1.3];
  "compras.solicitud_linea":c_solicitud_id -> "compras.solicitud":c_id ;
  "obra.almacen":c_proyecto_id -> "obra.proyecto":c_id ;
  "obra.asignacion":c_proyecto_id -> "obra.proyecto":c_id ;
  "obra.dispositivo":c_proyecto_id -> "obra.proyecto":c_id ;
  "obra.periodo":c_proyecto_id -> "obra.proyecto":c_id ;
  "obra.proyecto_plazo_historial":c_proyecto_id -> "obra.proyecto":c_id ;
  "outbox.evento":c_proyecto_id -> "obra.proyecto":c_id [color="#C00000", style=dashed, penwidth=1.3];
  "tareo.jornada":c_periodo_id -> "obra.periodo":c_id [color="#C00000", style=dashed, penwidth=1.3];
  "tareo.jornada":c_trabajador_id -> "tareo.trabajador":c_id [color="#2F5597", penwidth=1.4];
