o_id, proyecto_id)<BR/>  WHERE fecha_retiro IS NULL</B></FONT></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT" BGCOLOR="#F2F2F2"><FONT POINT-SIZE="9" COLOR="#444444">sin DELETE (se da de baja)</FONT></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT" BGCOLOR="#F2F2F2"><FONT POINT-SIZE="9" COLOR="#444444">reglas: asignacion_cambios, asignacion_retira_dispositivo</FONT></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT" BGCOLOR="#F2F2F2"><FONT POINT-SIZE="9" COLOR="#444444">2 CHECK · 1 índices</FONT></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT" BGCOLOR="#F2F2F2"><FONT POINT-SIZE="9" COLOR="#444444">permisos: obras S I U</FONT></TD></TR></TABLE>>];
