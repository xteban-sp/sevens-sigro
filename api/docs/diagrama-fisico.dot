    "almacen.movimiento" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#999999" STYLE="dashed"><TR><TD COLSPAN="2" BGCOLOR="#7F7F7F"><FONT COLOR="white"><B>almacen.movimiento</B></FONT><FONT COLOR="#FFD966"> APPEND-ONLY</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="c_uuid_cliente">uuid_cliente</TD><TD ALIGN="LEFT"><FONT COLOR="#B00020"><B>UNIQUE</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="c_almacen_id">almacen_id, proyecto_id</TD><TD ALIGN="LEFT"><FONT COLOR="#B00020">FK</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="c_periodo_id">periodo_id, proyecto_id</TD><TD ALIGN="LEFT"><FONT COLOR="#B00020">FK</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="c_dispositivo_id">dispositivo_id, proyecto_id</TD><TD ALIGN="LEFT"><FONT COLOR="#B00020">FK</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="c_insumo_id">insumo_id</TD><TD ALIGN="LEFT"><FONT COLOR="#B00020">FK</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="c_compra_id">compra_id (solo recepción)</TD><TD ALIGN="LEFT"><FONT COLOR="#B00020">FK</FONT></TD></TR><TR><TD ALIGN="LEFT">tipo · cantidad &gt; 0 · costo_unitario</TD><TD></TD></TR><TR><TD COLSPAN="2" ALIGN="LEFT" BGCOLOR="#FFF2CC"><FONT POINT-SIZE="10" COLOR="#7F6000"><B>SIN columna de saldo.</B><BR ALIGN="LEFT"/><B>El saldo se suma desde los movimientos.</B><BR ALIGN="LEFT"/><B>Sin UPDATE ni DELETE: corregir = reverso.</B><BR ALIGN="LEFT"/></FONT></TD></TR></TABLE>>];
  }
