    "tareo.jornada" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#6B2E6B"><TR><TD COLSPAN="3" BGCOLOR="#6B2E6B"><FONT COLOR="white"><B>tareo.</B><B>jornada</B></FONT><FONT COLOR="#FFD966"> APPEND-ONLY</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="c_id"><FONT POINT-SIZE="10" COLOR="#B00020"><B>PK</B></FONT></TD><TD ALIGN="LEFT">id</TD><TD ALIGN="LEFT"><FONT COLOR="#666666" POINT-SIZE="10">bigint</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="c_uuid_cliente"><FONT POINT-SIZE="10" COLOR="#B00020"><B>  </B></FONT></TD><TD ALIGN="LEFT">uuid_cliente</TD><TD ALIGN="LEFT"><FONT COLOR="#666666" POINT-SIZE="10">uuid?</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="c_proyecto_id"><FONT POINT-SIZE="10" COLOR="#B00020"><B>FK</B></FONT></TD><TD ALIGN="LEFT">proyecto_id</TD><TD ALIGN="LEFT"><FONT COLOR="#666666" POINT-SIZE="10">bigint</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="c_trabajador_id"><FONT POINT-SIZE="10" COLOR="#B00020"><B>FK</B></FONT></TD><TD ALIGN="LEFT">trabajador_id</TD><TD ALIGN="LEFT"><FONT COLOR="#666666" POINT-SIZE="10">bigint</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="c_fecha"><FONT POINT-SIZE="10" COLOR="#B00020"><B>FK</B></FONT></TD><TD ALIGN="LEFT">fecha</TD><TD ALIGN="LEFT"><FONT COLOR="#666666" POINT-SIZE="10">date</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="c_estado"><FONT POINT-SIZE="10" COLOR="#B00020"><B>  </B></FONT></TD><TD ALIGN="LEFT">estado</TD><TD ALIGN="LEFT"><FONT COLOR="#666666" POINT-SIZE="10">text</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="c_horas_normales"><FONT POINT-SIZE="10" COLOR="#B00020"><B>  </B></FONT></TD><TD ALIGN="LEFT">horas_normales</TD><TD ALIGN="LEFT"><FONT COLOR="#666666" POINT-SIZE="10">numeric(4,2)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="c_horas_extra"><FONT POINT-SIZE="10" COLOR="#B00020"><B>  </B></FONT></TD><TD ALIGN="LEFT">horas_extra</TD><TD ALIGN="LEFT"><FONT COLOR="#666666" POINT-SIZE="10">numeric(4,2)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="c_categoria"><FONT POINT-SIZE="10" COLOR="#B00020"><B>  </B></FONT></TD><TD ALIGN="LEFT">categoria</TD><TD ALIGN="LEFT"><FONT COLOR="#666666" POINT-SIZE="10">text</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="c_periodo_id"><FONT POINT-SIZE="10" COLOR="#B00020"><B>FK</B></FONT></TD><TD ALIGN="LEFT">periodo_id</TD><TD ALIGN="LEFT"><FONT COLOR="#666666" POINT-SIZE="10">bigint</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="c_registrado_por"><FONT POINT-SIZE="10" COLOR="#B00020"><B>FK</B></FONT></TD><TD ALIGN="LEFT">registrado_por</TD><TD ALIGN="LEFT"><FONT COLOR="#666666" POINT-SIZE="10">bigint</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="c_fecha_servidor"><FONT POINT-SIZE="10" COLOR="#B00020"><B>  </B></FONT></TD><TD ALIGN="LEFT">fecha_servidor</TD><TD ALIGN="LEFT"><FONT COLOR="#666666" POINT-SIZE="10">timestamptz</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="c_corrige_a_id"><FONT POINT-SIZE="10" COLOR="#B00020"><B>FK</B></FONT></TD><TD ALIGN="LEFT">corrige_a_id</TD><TD ALIGN="LEFT"><FONT COLOR="#666666" POINT-SIZE="10">bigint?</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="c_motivo_correccion"><FONT POINT-SIZE="10" COLOR="#B00020"><B>  </B></FONT></TD><TD ALIGN="LEFT">motivo_correccion</TD><TD ALIGN="LEFT"><FONT COLOR="#666666" POINT-SIZE="10">text?</FONT></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT" BGCOLOR="#FFF2CC"><FONT POINT-SIZE="10" COLOR="#7F6000"><B>UNIQUE (id, trabajador_id, fecha)</B></FONT></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT" BGCOLOR="#FFF2CC"><FONT POINT-SIZE="10" COLOR="#7F6000"><B>UNIQUE (trabajador_id, fecha)<BR/>  WHERE corrige_a_id IS NULL</B></FONT></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT" BGCOLOR="#FFF2CC"><FONT POINT-SIZE="10" COLOR="#7F6000"><B>UNIQUE (corrige_a_id)<BR/>  WHERE corrige_a_id IS NOT NULL</B></FONT></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT" BGCOLOR="#FFF2CC"><FONT POINT-SIZE="10" COLOR="#7F6000"><B>UNIQUE (uuid_cliente)<BR/>  WHERE uuid_cliente IS NOT NULL</B></FONT></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT" BGCOLOR="#F2F2F2"><FONT POINT-SIZE="9" COLOR="#444444">sin UPDATE · sin DELETE</FONT></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT" BGCOLOR="#F2F2F2"><FONT POINT-SIZE="9" COLOR="#444444">reglas: jornada_validar</FONT></TD></TR></TABLE>>];
    "tareo.trabajador" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#6B2E6B"><TR><TD COLSPAN="3" BGCOLOR="#6B2E6B"><FONT COLOR="white"><B>tareo.</B><B>trabajador</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="c_id"><FONT POINT-SIZE="10" COLOR="#B00020"><B>PK</B></FONT></TD><TD ALIGN="LEFT">id</TD><TD ALIGN="LEFT"><FONT COLOR="#666666" POINT-SIZE="10">bigint</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="c_proyecto_id"><FONT POINT-SIZE="10" COLOR="#B00020"><B>FK</B></FONT></TD><TD ALIGN="LEFT">proyecto_id</TD><TD ALIGN="LEFT"><FONT COLOR="#666666" POINT-SIZE="10">bigint</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="c_nombre"><FONT POINT-SIZE="10" COLOR="#B00020"><B>  </B></FONT></TD><TD ALIGN="LEFT">nombre</TD><TD ALIGN="LEFT"><FONT COLOR="#666666" POINT-SIZE="10">text</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="c_tipo_documento"><FONT POINT-SIZE="10" COLOR="#B00020"><B>  </B></FONT></TD><TD ALIGN="LEFT">tipo_documento</TD><TD ALIGN="LEFT"><FONT COLOR="#666666" POINT-SIZE="10">text</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="c_documento"><FONT POINT-SIZE="10" COLOR="#B00020"><B>  </B></FONT></TD><TD ALIGN="LEFT">documento</TD><TD ALIGN="LEFT"><FONT COLOR="#666666" POINT-SIZE="10">text</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="c_categoria"><FONT POINT-SIZE="10" COLOR="#B00020"><B>  </B></FONT></TD><TD ALIGN="LEFT">categoria</TD><TD ALIGN="LEFT"><FONT COLOR="#666666" POINT-SIZE="10">text</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="c_cuadrilla"><FONT POINT-SIZE="10" COLOR="#B00020"><B>  </B></FONT></TD><TD ALIGN="LEFT">cuadrilla</TD><TD ALIGN="LEFT"><FONT COLOR="#666666" POINT-SIZE="10">text</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="c_fecha_ingreso"><FONT POINT-SIZE="10" COLOR="#B00020"><B>  </B></FONT></TD><TD ALIGN="LEFT">fecha_ingreso</TD><TD ALIGN="LEFT"><FONT COLOR="#666666" POINT-SIZE="10">date</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="c_fecha_salida"><FONT POINT-SIZE="10" COLOR="#B00020"><B>  </B></FONT></TD><TD ALIGN="LEFT">fecha_salida</TD><TD ALIGN="LEFT"><FONT COLOR="#666666" POINT-SIZE="10">date?</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="c_registrado_por"><FONT POINT-SIZE="10" COLOR="#B00020"><B>FK</B></FONT></TD><TD ALIGN="LEFT">registrado_por</TD><TD ALIGN="LEFT"><FONT COLOR="#666666" POINT-SIZE="10">bigint</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="c_creado_en"><FONT POINT-SIZE="10" COLOR="#B00020"><B>  </B></FONT></TD><TD ALIGN="LEFT">creado_en</TD><TD ALIGN="LEFT"><FONT COLOR="#666666" POINT-SIZE="10">timestamptz</FONT></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT" BGCOLOR="#FFF2CC"><FONT POINT-SIZE="10" COLOR="#7F6000"><B>UNIQUE (proyecto_id, documento)</B></FONT></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT" BGCOLOR="#FFF2CC"><FONT POINT-SIZE="10" COLOR="#7F6000"><B>UNIQUE (id, proyecto_id)</B></FONT></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT" BGCOLOR="#F2F2F2"><FONT POINT-SIZE="9" COLOR="#444444">sin DELETE (se da de baja)</FONT></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT" BGCOLOR="#F2F2F2"><FONT POINT-SIZE="9" COLOR="#444444">reglas: trabajador_validar</FONT></TD></TR></TABLE>>];
