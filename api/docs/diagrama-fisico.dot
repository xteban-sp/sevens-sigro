    "compras.solicitud_linea" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#2E6B3A"><TR><TD COLSPAN="3" BGCOLOR="#2E6B3A"><FONT COLOR="white"><B>compras.</B><B>solicitud_linea</B></FONT><FONT COLOR="#FFD966"> APPEND-ONLY</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="c_id"><FONT POINT-SIZE="10" COLOR="#B00020"><B>PK</B></FONT></TD><TD ALIGN="LEFT">id</TD><TD ALIGN="LEFT"><FONT COLOR="#666666" POINT-SIZE="10">bigint</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="c_solicitud_id"><FONT POINT-SIZE="10" COLOR="#B00020"><B>FK</B></FONT></TD><TD ALIGN="LEFT">solicitud_id</TD><TD ALIGN="LEFT"><FONT COLOR="#666666" POINT-SIZE="10">bigint</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="c_insumo_id"><FONT POINT-SIZE="10" COLOR="#B00020"><B>FK</B></FONT></TD><TD ALIGN="LEFT">insumo_id</TD><TD ALIGN="LEFT"><FONT COLOR="#666666" POINT-SIZE="10">bigint?</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="c_descripcion_libre"><FONT POINT-SIZE="10" COLOR="#B00020"><B>  </B></FONT></TD><TD ALIGN="LEFT">descripcion_libre</TD><TD ALIGN="LEFT"><FONT COLOR="#666666" POINT-SIZE="10">text?</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="c_cantidad"><FONT POINT-SIZE="10" COLOR="#B00020"><B>  </B></FONT></TD><TD ALIGN="LEFT">cantidad</TD><TD ALIGN="LEFT"><FONT COLOR="#666666" POINT-SIZE="10">numeric(18,4)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="c_unidad_compra"><FONT POINT-SIZE="10" COLOR="#B00020"><B>  </B></FONT></TD><TD ALIGN="LEFT">unidad_compra</TD><TD ALIGN="LEFT"><FONT COLOR="#666666" POINT-SIZE="10">text</FONT></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT" BGCOLOR="#FFF2CC"><FONT POINT-SIZE="10" COLOR="#7F6000"><B>UNIQUE (solicitud_id, insumo_id)<BR/>  WHERE insumo_id IS NOT NULL</B></FONT></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT" BGCOLOR="#F2F2F2"><FONT POINT-SIZE="9" COLOR="#444444">sin UPDATE · sin DELETE</FONT></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT" BGCOLOR="#F2F2F2"><FONT POINT-SIZE="9" COLOR="#444444">reglas: solicitud_linea_vigente</FONT></TD></TR></TABLE>>];
  }
