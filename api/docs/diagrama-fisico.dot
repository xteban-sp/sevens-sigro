digraph SIGRO {
  graph [rankdir=LR, fontname="Helvetica", fontsize=26, labelloc=t, pad=0.4, nodesep=0.35, ranksep=1.3, splines=true, compound=true, newrank=true, label=<<B>SIGRO · Modelo físico de datos por microservicio</B><BR/><FONT POINT-SIZE="15">PostgreSQL 16.15 · migración 0009 · 23 tablas, 48 claves foráneas (24 entre servicios) · generado desde la base migrada</FONT>>];
  node [shape=plain, fontname="Helvetica", fontsize=11];
  edge [color="#555555", arrowsize=0.7, fontname="Helvetica", fontsize=9];
  subgraph cluster_obra { label=<<B>microservicio obras</B>  ·  esquema <B>obra</B>  ·  rol <B>sigro_svc_obras</B><BR/><FONT POINT-SIZE="12">identidad, sesión, usuarios, obras, periodos, almacenes, asignaciones, dispositivos; decide quién puede qué</FONT>>; fontsize=18; style="rounded,filled"; fillcolor="#EAF1F8"; color="#1F4E79"; penwidth=2;
