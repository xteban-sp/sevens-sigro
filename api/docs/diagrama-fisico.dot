digraph SIGRO {
  graph [rankdir=LR, fontname="Helvetica", fontsize=26, labelloc=t, pad=0.4, nodesep=0.35, ranksep=1.3, splines=true, compound=true, newrank=true, label=<<B>SIGRO · Diagrama físico de la base de datos (PostgreSQL)</B><BR/><FONT POINT-SIZE="15">Módulos obra, catálogo, compras y tareo · generado desde la base migrada (migraciones 0001 a 0005)</FONT>>];
  node [shape=plain, fontname="Helvetica", fontsize=11];
  edge [color="#555555", arrowsize=0.7, fontname="Helvetica", fontsize=9];
  subgraph cluster_obra { label=<<B>esquema obra</B>>; fontsize=18; style="rounded,filled"; fillcolor="#EAF1F8"; color="#1F4E79"; penwidth=2;
    "obra.almacen" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#1F4E79"><TR><TD COLSPAN="3" BGCOLOR="#1F4E79"><FONT COLOR="white"><B>obra.</B><B>almacen</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="c_id"><FONT POINT-SIZE="10" COLOR="#B00020"><B>PK</B></FONT></TD><TD ALIGN="LEFT">id</TD><TD ALIGN="LEFT"><FONT COLOR="#666666" POINT-SIZE="10">bigint</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="c_proyecto_id"><FONT POINT-SIZE="10" COLOR="#B00020"><B>FK</B></FONT></TD><TD ALIGN="LEFT">proyecto_id</TD><TD ALIGN="LEFT"><FONT COLOR="#666666" POINT-SIZE="10">bigint</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="c_nombre"><FONT POINT-SIZE="10" COLOR="#B00020"><B>  </B></FONT></TD><TD ALIGN="LEFT">nombre</TD><TD ALIGN="LEFT"><FONT COLOR="#666666" POINT-SIZE="10">text</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="c_tipo"><FONT POINT-SIZE="10" COLOR="#B00020"><B>  </B></FONT></TD><TD ALIGN="LEFT">tipo</TD><TD ALIGN="LEFT"><FONT COLOR="#666666" POINT-SIZE="10">text</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="c_estado"><FONT POINT-SIZE="10" COLOR="#B00020"><B>  </B></FONT></TD><TD ALIGN="LEFT">estado</TD><TD ALIGN="LEFT"><FONT COLOR="#666666" POINT-SIZE="10">text</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="c_creado_en"><FONT POINT-SIZE="10" COLOR="#B00020"><B>  </B></FONT></TD><TD ALIGN="LEFT">creado_en</TD><TD ALIGN="LEFT"><FONT COLOR="#666666" POINT-SIZE="10">timestamptz</FONT></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT" BGCOLOR="#FFF2CC"><FONT POINT-SIZE="10" COLOR="#7F6000"><B>UNIQUE (id, proyecto_id)</B></FONT></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT" BGCOLOR="#FFF2CC"><FONT POINT-SIZE="10" COLOR="#7F6000"><B>UNIQUE (proyecto_id, lower(nombre))</B></FONT></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT" BGCOLOR="#F2F2F2"><FONT POINT-SIZE="9" COLOR="#444444">sin DELETE (se da de baja)</FONT></TD></TR></TABLE>>];
    "obra.asignacion" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#1F4E79"><TR><TD COLSPAN="3" BGCOLOR="#1F4E79"><FONT COLOR="white"><B>obra.</B><B>asignacion</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="c_id"><FONT POINT-SIZE="10" COLOR="#B00020"><B>PK</B></FONT></TD><TD ALIGN="LEFT">id</TD><TD ALIGN="LEFT"><FONT COLOR="#666666" POINT-SIZE="10">bigint</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="c_usuario_id"><FONT POINT-SIZE="10" COLOR="#B00020"><B>FK</B></FONT></TD><TD ALIGN="LEFT">usuario_id</TD><TD ALIGN="LEFT"><FONT COLOR="#666666" POINT-SIZE="10">bigint</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="c_proyecto_id"><FONT POINT-SIZE="10" COLOR="#B00020"><B>FK</B></FONT></TD><TD ALIGN="LEFT">proyecto_id</TD><TD ALIGN="LEFT"><FONT COLOR="#666666" POINT-SIZE="10">bigint</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="c_rol"><FONT POINT-SIZE="10" COLOR="#B00020"><B>  </B></FONT></TD><TD ALIGN="LEFT">rol</TD><TD ALIGN="LEFT"><FONT COLOR="#666666" POINT-SIZE="10">text</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="c_asignado_por"><FONT POINT-SIZE="10" COLOR="#B00020"><B>FK</B></FONT></TD><TD ALIGN="LEFT">asignado_por</TD><TD ALIGN="LEFT"><FONT COLOR="#666666" POINT-SIZE="10">bigint</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="c_fecha_asignacion"><FONT POINT-SIZE="10" COLOR="#B00020"><B>  </B></FONT></TD><TD ALIGN="LEFT">fecha_asignacion</TD><TD ALIGN="LEFT"><FONT COLOR="#666666" POINT-SIZE="10">timestamptz</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="c_fecha_retiro"><FONT POINT-SIZE="10" COLOR="#B00020"><B>  </B></FONT></TD><TD ALIGN="LEFT">fecha_retiro</TD><TD ALIGN="LEFT"><FONT COLOR="#666666" POINT-SIZE="10">timestamptz?</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="c_retirado_por"><FONT POINT-SIZE="10" COLOR="#B00020"><B>FK</B></FONT></TD><TD ALIGN="LEFT">retirado_por</TD><TD ALIGN="LEFT"><FONT COLOR="#666666" POINT-SIZE="10">bigint?</FONT></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT" BGCOLOR="#FFF2CC"><FONT POINT-SIZE="10" COLOR="#7F6000"><B>UNIQUE (usuario_id, proyecto_id)<BR/>  WHERE fecha_retiro IS NULL</B></FONT></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT" BGCOLOR="#F2F2F2"><FONT POINT-SIZE="9" COLOR="#444444">sin DELETE (se da de baja)</FONT></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT" BGCOLOR="#F2F2F2"><FONT POINT-SIZE="9" COLOR="#444444">reglas: asignacion_cambios, asignacion_retira_dispositivo</FONT></TD></TR></TABLE>>];
    "obra.dispositivo" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#1F4E79"><TR><TD COLSPAN="3" BGCOLOR="#1F4E79"><FONT COLOR="white"><B>obra.</B><B>dispositivo</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="c_id"><FONT POINT-SIZE="10" COLOR="#B00020"><B>PK</B></FONT></TD><TD ALIGN="LEFT">id</TD><TD ALIGN="LEFT"><FONT COLOR="#666666" POINT-SIZE="10">bigint</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="c_proyecto_id"><FONT POINT-SIZE="10" COLOR="#B00020"><B>FK</B></FONT></TD><TD ALIGN="LEFT">proyecto_id</TD><TD ALIGN="LEFT"><FONT COLOR="#666666" POINT-SIZE="10">bigint</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="c_usuario_id"><FONT POINT-SIZE="10" COLOR="#B00020"><B>FK</B></FONT></TD><TD ALIGN="LEFT">usuario_id</TD><TD ALIGN="LEFT"><FONT COLOR="#666666" POINT-SIZE="10">bigint</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="c_identificador"><FONT POINT-SIZE="10" COLOR="#B00020"><B>  </B></FONT></TD><TD ALIGN="LEFT">identificador</TD><TD ALIGN="LEFT"><FONT COLOR="#666666" POINT-SIZE="10">text</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="c_estado"><FONT POINT-SIZE="10" COLOR="#B00020"><B>  </B></FONT></TD><TD ALIGN="LEFT">estado</TD><TD ALIGN="LEFT"><FONT COLOR="#666666" POINT-SIZE="10">text</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="c_solicitado_en"><FONT POINT-SIZE="10" COLOR="#B00020"><B>  </B></FONT></TD><TD ALIGN="LEFT">solicitado_en</TD><TD ALIGN="LEFT"><FONT COLOR="#666666" POINT-SIZE="10">timestamptz</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="c_autorizado_por"><FONT POINT-SIZE="10" COLOR="#B00020"><B>FK</B></FONT></TD><TD ALIGN="LEFT">autorizado_por</TD><TD ALIGN="LEFT"><FONT COLOR="#666666" POINT-SIZE="10">bigint?</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="c_fecha_autorizacion"><FONT POINT-SIZE="10" COLOR="#B00020"><B>  </B></FONT></TD><TD ALIGN="LEFT">fecha_autorizacion</TD><TD ALIGN="LEFT"><FONT COLOR="#666666" POINT-SIZE="10">timestamptz?</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="c_revocado_por"><FONT POINT-SIZE="10" COLOR="#B00020"><B>FK</B></FONT></TD><TD ALIGN="LEFT">revocado_por</TD><TD ALIGN="LEFT"><FONT COLOR="#666666" POINT-SIZE="10">bigint?</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="c_fecha_revocacion"><FONT POINT-SIZE="10" COLOR="#B00020"><B>  </B></FONT></TD><TD ALIGN="LEFT">fecha_revocacion</TD><TD ALIGN="LEFT"><FONT COLOR="#666666" POINT-SIZE="10">timestamptz?</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="c_motivo_revocacion"><FONT POINT-SIZE="10" COLOR="#B00020"><B>  </B></FONT></TD><TD ALIGN="LEFT">motivo_revocacion</TD><TD ALIGN="LEFT"><FONT COLOR="#666666" POINT-SIZE="10">text?</FONT></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT" BGCOLOR="#FFF2CC"><FONT POINT-SIZE="10" COLOR="#7F6000"><B>UNIQUE (id, proyecto_id)</B></FONT></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT" BGCOLOR="#FFF2CC"><FONT POINT-SIZE="10" COLOR="#7F6000"><B>UNIQUE (proyecto_id, usuario_id)<BR/>  WHERE estado = &#x27;activo&#x27;</B></FONT></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT" BGCOLOR="#FFF2CC"><FONT POINT-SIZE="10" COLOR="#7F6000"><B>UNIQUE (proyecto_id, identificador)<BR/>  WHERE estado = &#x27;activo&#x27;</B></FONT></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT" BGCOLOR="#F2F2F2"><FONT POINT-SIZE="9" COLOR="#444444">sin DELETE (se da de baja)</FONT></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT" BGCOLOR="#F2F2F2"><FONT POINT-SIZE="9" COLOR="#444444">reglas: dispositivo</FONT></TD></TR></TABLE>>];
    "obra.periodo" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#1F4E79"><TR><TD COLSPAN="3" BGCOLOR="#1F4E79"><FONT COLOR="white"><B>obra.</B><B>periodo</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="c_id"><FONT POINT-SIZE="10" COLOR="#B00020"><B>PK</B></FONT></TD><TD ALIGN="LEFT">id</TD><TD ALIGN="LEFT"><FONT COLOR="#666666" POINT-SIZE="10">bigint</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="c_proyecto_id"><FONT POINT-SIZE="10" COLOR="#B00020"><B>FK</B></FONT></TD><TD ALIGN="LEFT">proyecto_id</TD><TD ALIGN="LEFT"><FONT COLOR="#666666" POINT-SIZE="10">bigint</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="c_numero"><FONT POINT-SIZE="10" COLOR="#B00020"><B>  </B></FONT></TD><TD ALIGN="LEFT">numero</TD><TD ALIGN="LEFT"><FONT COLOR="#666666" POINT-SIZE="10">integer</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="c_fecha_inicio"><FONT POINT-SIZE="10" COLOR="#B00020"><B>  </B></FONT></TD><TD ALIGN="LEFT">fecha_inicio</TD><TD ALIGN="LEFT"><FONT COLOR="#666666" POINT-SIZE="10">date</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="c_fecha_fin"><FONT POINT-SIZE="10" COLOR="#B00020"><B>  </B></FONT></TD><TD ALIGN="LEFT">fecha_fin</TD><TD ALIGN="LEFT"><FONT COLOR="#666666" POINT-SIZE="10">date</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="c_estado"><FONT POINT-SIZE="10" COLOR="#B00020"><B>  </B></FONT></TD><TD ALIGN="LEFT">estado</TD><TD ALIGN="LEFT"><FONT COLOR="#666666" POINT-SIZE="10">text</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="c_cerrado_en"><FONT POINT-SIZE="10" COLOR="#B00020"><B>  </B></FONT></TD><TD ALIGN="LEFT">cerrado_en</TD><TD ALIGN="LEFT"><FONT COLOR="#666666" POINT-SIZE="10">timestamptz?</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="c_cerrado_por"><FONT POINT-SIZE="10" COLOR="#B00020"><B>FK</B></FONT></TD><TD ALIGN="LEFT">cerrado_por</TD><TD ALIGN="LEFT"><FONT COLOR="#666666" POINT-SIZE="10">bigint?</FONT></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT" BGCOLOR="#FFF2CC"><FONT POINT-SIZE="10" COLOR="#7F6000"><B>UNIQUE (proyecto_id, numero)</B></FONT></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT" BGCOLOR="#FFF2CC"><FONT POINT-SIZE="10" COLOR="#7F6000"><B>UNIQUE (id, proyecto_id)</B></FONT></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT" BGCOLOR="#F2F2F2"><FONT POINT-SIZE="9" COLOR="#444444">sin DELETE (se da de baja)</FONT></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT" BGCOLOR="#F2F2F2"><FONT POINT-SIZE="9" COLOR="#444444">reglas: periodo_cambios</FONT></TD></TR></TABLE>>];
    "obra.proyecto" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#1F4E79"><TR><TD COLSPAN="3" BGCOLOR="#1F4E79"><FONT COLOR="white"><B>obra.</B><B>proyecto</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="c_id"><FONT POINT-SIZE="10" COLOR="#B00020"><B>PK</B></FONT></TD><TD ALIGN="LEFT">id</TD><TD ALIGN="LEFT"><FONT COLOR="#666666" POINT-SIZE="10">bigint</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="c_nombre"><FONT POINT-SIZE="10" COLOR="#B00020"><B>  </B></FONT></TD><TD ALIGN="LEFT">nombre</TD><TD ALIGN="LEFT"><FONT COLOR="#666666" POINT-SIZE="10">text</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="c_fecha_inicio"><FONT POINT-SIZE="10" COLOR="#B00020"><B>  </B></FONT></TD><TD ALIGN="LEFT">fecha_inicio</TD><TD ALIGN="LEFT"><FONT COLOR="#666666" POINT-SIZE="10">date</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="c_fecha_fin"><FONT POINT-SIZE="10" COLOR="#B00020"><B>  </B></FONT></TD><TD ALIGN="LEFT">fecha_fin</TD><TD ALIGN="LEFT"><FONT COLOR="#666666" POINT-SIZE="10">date</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="c_dia_corte"><FONT POINT-SIZE="10" COLOR="#B00020"><B>  </B></FONT></TD><TD ALIGN="LEFT">dia_corte</TD><TD ALIGN="LEFT"><FONT COLOR="#666666" POINT-SIZE="10">smallint</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="c_estado"><FONT POINT-SIZE="10" COLOR="#B00020"><B>  </B></FONT></TD><TD ALIGN="LEFT">estado</TD><TD ALIGN="LEFT"><FONT COLOR="#666666" POINT-SIZE="10">text</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="c_creado_por"><FONT POINT-SIZE="10" COLOR="#B00020"><B>FK</B></FONT></TD><TD ALIGN="LEFT">creado_por</TD><TD ALIGN="LEFT"><FONT COLOR="#666666" POINT-SIZE="10">bigint</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="c_creado_en"><FONT POINT-SIZE="10" COLOR="#B00020"><B>  </B></FONT></TD><TD ALIGN="LEFT">creado_en</TD><TD ALIGN="LEFT"><FONT COLOR="#666666" POINT-SIZE="10">timestamptz</FONT></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT" BGCOLOR="#FFF2CC"><FONT POINT-SIZE="10" COLOR="#7F6000"><B>UNIQUE (lower(nombre))</B></FONT></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT" BGCOLOR="#F2F2F2"><FONT POINT-SIZE="9" COLOR="#444444">sin DELETE (se da de baja)</FONT></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT" BGCOLOR="#F2F2F2"><FONT POINT-SIZE="9" COLOR="#444444">reglas: proyecto_cambios, proyecto_genera_periodos</FONT></TD></TR></TABLE>>];
    "obra.proyecto_plazo_historial" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#1F4E79"><TR><TD COLSPAN="3" BGCOLOR="#1F4E79"><FONT COLOR="white"><B>obra.</B><B>proyecto_plazo_historial</B></FONT><FONT COLOR="#FFD966"> APPEND-ONLY</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="c_id"><FONT POINT-SIZE="10" COLOR="#B00020"><B>PK</B></FONT></TD><TD ALIGN="LEFT">id</TD><TD ALIGN="LEFT"><FONT COLOR="#666666" POINT-SIZE="10">bigint</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="c_proyecto_id"><FONT POINT-SIZE="10" COLOR="#B00020"><B>FK</B></FONT></TD><TD ALIGN="LEFT">proyecto_id</TD><TD ALIGN="LEFT"><FONT COLOR="#666666" POINT-SIZE="10">bigint</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="c_fecha_fin_anterior"><FONT POINT-SIZE="10" COLOR="#B00020"><B>  </B></FONT></TD><TD ALIGN="LEFT">fecha_fin_anterior</TD><TD ALIGN="LEFT"><FONT COLOR="#666666" POINT-SIZE="10">date</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="c_fecha_fin_nueva"><FONT POINT-SIZE="10" COLOR="#B00020"><B>  </B></FONT></TD><TD ALIGN="LEFT">fecha_fin_nueva</TD><TD ALIGN="LEFT"><FONT COLOR="#666666" POINT-SIZE="10">date</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="c_motivo"><FONT POINT-SIZE="10" COLOR="#B00020"><B>  </B></FONT></TD><TD ALIGN="LEFT">motivo</TD><TD ALIGN="LEFT"><FONT COLOR="#666666" POINT-SIZE="10">text</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="c_autor"><FONT POINT-SIZE="10" COLOR="#B00020"><B>FK</B></FONT></TD><TD ALIGN="LEFT">autor</TD><TD ALIGN="LEFT"><FONT COLOR="#666666" POINT-SIZE="10">bigint</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="c_fecha"><FONT POINT-SIZE="10" COLOR="#B00020"><B>  </B></FONT></TD><TD ALIGN="LEFT">fecha</TD><TD ALIGN="LEFT"><FONT COLOR="#666666" POINT-SIZE="10">timestamptz</FONT></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT" BGCOLOR="#F2F2F2"><FONT POINT-SIZE="9" COLOR="#444444">sin UPDATE · sin DELETE</FONT></TD></TR></TABLE>>];
    "obra.usuario" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#1F4E79"><TR><TD COLSPAN="3" BGCOLOR="#1F4E79"><FONT COLOR="white"><B>obra.</B><B>usuario</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="c_id"><FONT POINT-SIZE="10" COLOR="#B00020"><B>PK</B></FONT></TD><TD ALIGN="LEFT">id</TD><TD ALIGN="LEFT"><FONT COLOR="#666666" POINT-SIZE="10">bigint</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="c_nombre"><FONT POINT-SIZE="10" COLOR="#B00020"><B>  </B></FONT></TD><TD ALIGN="LEFT">nombre</TD><TD ALIGN="LEFT"><FONT COLOR="#666666" POINT-SIZE="10">text</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="c_usuario"><FONT POINT-SIZE="10" COLOR="#B00020"><B>  </B></FONT></TD><TD ALIGN="LEFT">usuario</TD><TD ALIGN="LEFT"><FONT COLOR="#666666" POINT-SIZE="10">text</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="c_hash_clave"><FONT POINT-SIZE="10" COLOR="#B00020"><B>  </B></FONT></TD><TD ALIGN="LEFT">hash_clave</TD><TD ALIGN="LEFT"><FONT COLOR="#666666" POINT-SIZE="10">text</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="c_estado"><FONT POINT-SIZE="10" COLOR="#B00020"><B>  </B></FONT></TD><TD ALIGN="LEFT">estado</TD><TD ALIGN="LEFT"><FONT COLOR="#666666" POINT-SIZE="10">text</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="c_fecha_baja"><FONT POINT-SIZE="10" COLOR="#B00020"><B>  </B></FONT></TD><TD ALIGN="LEFT">fecha_baja</TD><TD ALIGN="LEFT"><FONT COLOR="#666666" POINT-SIZE="10">timestamptz?</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="c_intentos_fallidos"><FONT POINT-SIZE="10" COLOR="#B00020"><B>  </B></FONT></TD><TD ALIGN="LEFT">intentos_fallidos</TD><TD ALIGN="LEFT"><FONT COLOR="#666666" POINT-SIZE="10">smallint</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="c_bloqueado_hasta"><FONT POINT-SIZE="10" COLOR="#B00020"><B>  </B></FONT></TD><TD ALIGN="LEFT">bloqueado_hasta</TD><TD ALIGN="LEFT"><FONT COLOR="#666666" POINT-SIZE="10">timestamptz?</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="c_creado_en"><FONT POINT-SIZE="10" COLOR="#B00020"><B>  </B></FONT></TD><TD ALIGN="LEFT">creado_en</TD><TD ALIGN="LEFT"><FONT COLOR="#666666" POINT-SIZE="10">timestamptz</FONT></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT" BGCOLOR="#FFF2CC"><FONT POINT-SIZE="10" COLOR="#7F6000"><B>UNIQUE (lower(usuario))</B></FONT></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT" BGCOLOR="#F2F2F2"><FONT POINT-SIZE="9" COLOR="#444444">sin DELETE (se da de baja)</FONT></TD></TR></TABLE>>];
  }
