# Copia a .env y cambia TODOS los valores. .env NO se sube al repositorio.
POSTGRES_OWNER_CLAVE=cambia-esto-dueno
# Una contraseña por microservicio: cada uno entra a la base con SU usuario y solo ve SU esquema.
SIGRO_CLAVE_OBRAS=cambia-esto-obras
SIGRO_CLAVE_CATALOGO=cambia-esto-catalogo
SIGRO_CLAVE_COMPRAS=cambia-esto-compras
SIGRO_CLAVE_TAREO=cambia-esto-tareo
SIGRO_CLAVE_RELEVO=cambia-esto-relevo
SIGRO_JWT_SECRET=cambia-esto-por-al-menos-32-caracteres-aleatorios
# Token que se exigen los servicios entre sí (API /interno, integraciones, notificaciones).
SIGRO_SERVICIO_TOKEN=cambia-esto-token-entre-servicios-32-caracteres
# Token de Factiliza (Fernando). Sin él, validar un RUC contra SUNAT responde "no disponible" y el proveedor queda sin validar.
FACTILIZA_TOKEN=
